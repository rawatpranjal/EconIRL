  "meta": {
    "title": "Abstract MDP 4: an interaction effect in the reward",
    "date": "2026-06-12",
    "package_version": "0.0.6",
    "n_replications": 3,
    "dgp": {
      "num_states": 24,
      "num_actions": 3,
      "discount_factor": 0.95,
      "theta": [
        1.0,
        -0.8
      ],
      "gamma": 2.5,
      "branching": 4,
      "seed": 404
    },
    "n_individuals": 300,
    "n_periods": 50,
    "oracle": "true-reward policy/value via SoftBellmanOperator + value_iteration",
    "determinism": "structural estimators are deterministic given the seeds; neural estimators may have nondeterministic training internals, so their behavioral numbers can vary slightly across runs",
    "excluded": [
      {
        "name": "GAIL",
        "reason": "known slow (~9 min/fit); not run here"
      },
      {
        "name": "DeepMaxEnt-IRL",
